# TLS для Mini App: Caddy слушает 443, сам получает сертификат Let's Encrypt
# для sslip.io-имени (это IP сервера, записанный через дефисы) и проксирует
# на web-контейнер. Порт 80 занят TripOS, поэтому наружу торчит только 443,
# а сертификат выдаётся через TLS-ALPN-челлендж — ему хватает 443.
# Кладётся в /opt/finance деплоем finance_helper_back.

# Маршруты соседних стеков на этой машине. Каталог лежит вне /opt/finance
# намеренно: этот деплой кладёт свои файлы в /opt/finance через scp, и
# пересекать владение путями между стеками незачем. Пустой каталог — валидное
# состояние, import по пустой маске просто ничего не подставляет.
import /etc/caddy/conf.d/*.caddy

147-45-238-246.sslip.io {
	reverse_proxy web:3000
}
